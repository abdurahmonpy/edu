# ===========================================================================
# Englify backend — environment template
# Copy to `.env` (repo root or backend/) and fill in. Railway: set these as
# service variables instead; the file is only for local development.
# ===========================================================================

# --- general ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- database --------------------------------------------------------------
# Railway -> Postgres plugin -> "Connect" -> copy DATABASE_URL.
# The backend accepts postgres://, postgresql:// and postgresql+asyncpg:// forms
# and rewrites them automatically. `sslmode=require` is translated for asyncpg.
#
# DATABASE_URL=postgresql://postgres:PASSWORD@containers-us-west-1.railway.app:6543/railway
#
# Local development needs nothing at all — falls back to a SQLite file:
DATABASE_URL=sqlite+aiosqlite:///./englify.db
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true
# Local demo accounts; always keep false on Railway production.
SEED_DEMO_ACCOUNTS=true
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- auth ------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=10
LOGIN_LOCKOUT_MINUTES=15
GOOGLE_CLIENT_ID=

# --- cors ------------------------------------------------------------------
# "*" or a comma separated list, e.g.
# CORS_ORIGINS=https://edu-eng.vercel.app,https://englify.up.railway.app
CORS_ORIGINS=*

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- email (password reset delivery; configure for production) -------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=Englify
# SMTP_STARTTLS=true

# --- frontend --------------------------------------------------------------
SERVE_FRONTEND=true

# --- development only ------------------------------------------------------
# Returns the password-reset token in the API response (no SMTP configured).
# NEVER enable this in production.
EXPOSE_RESET_TOKEN=false
